# App
APP_PASSWORD=changeme
# Opt-in mock generation (unset/false = OpenAI). Only "true" enables mocks.
USE_MOCK_GENERATION=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required — long random string, do NOT reuse APP_PASSWORD
AUTH_SECRET=generate-a-long-random-string

# Supabase (server requires SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Etsy
ETSY_API_KEY=your_keystring
ETSY_SHARED_SECRET=your_shared_secret
ETSY_SHOP_ID=
ETSY_REDIRECT_URI=http://localhost:3000/api/etsy/callback
# Per-product taxonomy overrides (optional). Example: ETSY_TAXONOMY_ID_T_SHIRT=1101
ETSY_TAXONOMY_ID_T_SHIRT=
ETSY_REFRESH_TOKEN=
